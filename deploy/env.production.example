# 复制这些项目到 Multica 官方仓库 make selfhost 生成的 .env 中。
# 不要覆盖安装程序生成的随机密码和 Secret。
# 不要将真实 .env 提交到 Git。

APP_ENV=production

FRONTEND_ORIGIN=https://app.example.com
MULTICA_APP_URL=https://app.example.com
MULTICA_PUBLIC_URL=https://api.example.com

# 公开部署建议默认关闭任意注册，通过管理员邀请用户。
ALLOW_SIGNUP=false

# 根据 Multica 当前版本配置邮件服务后再启用邀请和验证码邮件。
# RESEND_API_KEY=
# EMAIL_FROM=Multica <multica@example.com>
